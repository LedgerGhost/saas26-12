# JWT
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (leave blank to use dev-login endpoint only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
FRONTEND_URL=http://localhost
# Same OAuth Client ID, baked into the SPA at build time (Vite inlines VITE_*).
VITE_GOOGLE_CLIENT_ID=

# Payment gateway API keys (e.g. Stripe, PayPal) 
STRIPE_SECRET_KEY=your_actual_secret_key
STRIPE_WEBHOOK_SECRET=your_actual_webhook_secret

# Provider API base URLs (NTUA hypothetical providers)
REDPLUG_API_BASE_URL=https://davinci.softlab.ntua.gr/saas26/redPlug/api
REDPLUG_API_KEY=
GREENPLUG_API_BASE_URL=https://davinci.softlab.ntua.gr/saas26/greenPlug/api
GREENPLUG_API_KEY=
BLUEPLUG_API_BASE_URL=https://davinci.softlab.ntua.gr/saas26/bluePlug/api
BLUEPLUG_API_KEY=

# RabbitMQ
RABBITMQ_USER=saasplug
RABBITMQ_PASS=saasplug
RABBITMQ_URL=amqp://saasplug:saasplug@rabbitmq:5672

# Stations cache (seconds)
STATIONS_CACHE_TTL_SEC=300

# Shared secret for internal service-to-service calls (e.g. provider-service -> auth-service /credentials).
# Treat like JWT_SECRET — long random string, never exposed to clients.
INTERNAL_AUTH_TOKEN=change-me-to-a-long-random-internal-token

# Controls ALL demo/dev account functionality:
#   - Shows/hides the dev login form and role picker in the UI (via VITE_DEV_LOGIN build arg)
#   - Enables/disables POST /api/auth/dev-login (any role, no Google required)
#   - Enables/disables the email/name path in POST /api/auth/bootstrap
# Enabled by default when unset. Set to false to fully disable demo access.
ALLOW_DEV_LOGIN=true
